// Stage 4: bounded values, inference, and documented function signatures.

/// Creates a greeting with capacities inferred independently for every call.
/// The greeting argument is optional and defaults to "Hello".
func greet(name: string, greeting: string = "Hello") -> string {
    return greeting + ", " + name;
}

/// Describes whether a service is healthy.
func service_status(service: string, healthy: bool) -> string {
    if healthy {
        return service + " is healthy";
    } else {
        return service + " needs attention";
    }
}

/// Reports whether a port is one of the conventional HTTP ports.
func is_http_port(port: uint16) -> bool {
    if port == 80 {
        return true;
    } else {
        return port == 443;
    }
}

/// Chooses a bounded worker count from the current server load.
func recommended_workers(load: double) -> uint8 {
    if load >= 0.8 {
        return 16;
    } else {
        return 4;
    }
}

/// Calculates a completion ratio using double-precision arithmetic.
func completion_ratio(completed: double, total: double) -> double {
    return completed / total;
}

/// Reports whether a character separates words in a command name.
func is_separator(value: char) -> bool {
    return value == '-';
}

/// Prints a bounded message and intentionally returns unit.
func announce(message: string) -> unit {
    print message;
}

/// Builds a message while letting Orni infer the local string allocation.
func inferred_welcome(name: string) -> string {
    let prefix = "Welcome, ";
    return prefix + name;
}

// Hover these variables to inspect their compiler-inferred limits.
let project = "Orni";
let status: string = "Ready";
let unicode_status = "Olá, Orni!";
let retries = 3;
let port = 8080;
let users = 250000;
let distance = 9000000000;
let load = 0.85;

print greet(project);
print greet(project, "Welcome");
print inferred_welcome(project);
print status;
print unicode_status;
print retries;
print port;
print users;
print distance;
print service_status("api", true);
print is_http_port(8080);
print recommended_workers(load);
print completion_ratio(3, 4);
print is_separator('-');
announce("All type-safety examples completed.");
