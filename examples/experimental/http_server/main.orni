/// Describes a user returned by future JSON API routes.
model User {
    id: uuid;
    name: string<80>;
    email: string<254>, email, unique;
}

/// Defines the client-owned fields accepted when creating a user.
model CreateUser {
    name: string<80>;
    email: string<254>, email;
}

/// Defines the editable fields accepted when replacing a user.
model UpdateUser {
    name: string<80>;
    email: string<254>, email;
}

/// Declares the fields accepted individually by a partial user update.
model PatchUser {
    name: string<80>;
    email: string<254>, email;
}

/// Keeps users in memory for the lifetime of this local development server.
store users: User;

/// Returns a created JSON resource after the HTTP boundary validates its body.
func create_user(input: CreateUser) -> response {
    return response.json(users.create(input));
}

route post "/users" => create_user;

/// Returns a bounded cursor window without counting the complete collection.
func list_users(search: string = "", limit: uint16 = 20, cursor: string = "") -> response {
    return response.collection(users.search("name", search, limit, cursor));
}

route get "/users" => list_users;

/// Finds one user by its validated UUID primary key.
func get_user(id: uuid) -> response {
    return users.find(id);
}

route get "/users/:id" => get_user;

/// Replaces a user using the UUID already present in the route.
func update_user(id: uuid, input: UpdateUser) -> response {
    return users.replace(id, input);
}

route put "/users/:id" => update_user;

/// Updates only the fields present in the JSON request body.
func patch_user(id: uuid, input: PatchUser) -> response {
    return users.patch(id, input);
}

route patch "/users/:id" => patch_user;

/// Deletes a user and returns an empty successful response.
func delete_user(id: uuid) -> response {
    return users.delete(id);
}

route delete "/users/:id" => delete_user;

/// Returns the response body for a named greeting route.
func hello(name: string) -> string {
    return "Hello, " + name + "!";
}

route get "/hello/:name" => hello;

/// Returns a response for a UUID generated by another system.
func profile(id: uuid) -> string {
    return "Profile #" + id;
}

route get "/profiles/:id" => profile;
