{
  "name": "orni-language",
  "displayName": "Orni Language",
  "description": "Language support for the Orni programming language.",
  "version": "0.7.5",
  "publisher": "orni-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasConstantino92/orni-lang.git"
  },
  "engines": {
    "vscode": ">=1.80.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["orni", "language", "syntax"],
  "files": [
    "extension.js",
    "language-support.js",
    "LICENSE",
    "icons",
    "syntaxes",
    "language-configuration.json",
    "README.md"
  ],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:orni"],
  "contributes": {
    "commands": [
      {
        "command": "orni.checkModule",
        "title": "Orni: Check Current File as Module"
      }
    ],
    "languages": [
      {
        "id": "orni",
        "aliases": ["Orni", "orni"],
        "extensions": [".orni"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/orni-file.png",
          "dark": "./icons/orni-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "orni",
        "scopeName": "source.orni",
        "path": "./syntaxes/orni.tmLanguage.json"
      }
    ]
  }
}
