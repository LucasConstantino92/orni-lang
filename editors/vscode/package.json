{
  "name": "orni-language",
  "displayName": "Orni Language",
  "description": "Language support for the Orni programming language.",
  "version": "0.9.1",
  "publisher": "orni-lang",
  "icon": "icons/orni-file.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasConstantino92/orni-lang.git"
  },
  "engines": {
    "vscode": ">=1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "orni",
    "language",
    "syntax"
  ],
  "files": [
    "extension.js",
    "language-support.js",
    "project-support.js",
    "compiler-client.js",
    "diagnostic-guidance.js",
    "diagnostic-catalog.js",
    "dependency-index.js",
    "diagnostics.js",
    "diagnostic-ui.js",
    "code-actions.js",
    "module-actions.js",
    "editor-symbols.js",
    "editor-navigation.js",
    "compiler",
    "node_modules/@iarna/toml/**",
    "LICENSE",
    "icons",
    "syntaxes",
    "language-configuration.json",
    "README.md"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node ../../tools/package-editor.mjs",
    "test": "node --test test/language-support.test.js test/project-support.test.js test/diagnostic-guidance.test.js test/dependency-index.test.js",
    "test:host": "node test/run-host.cjs"
  },
  "activationEvents": [
    "onLanguage:orni",
    "workspaceContains:**/*.orni"
  ],
  "contributes": {
    "configuration": {
      "title": "Orni",
      "properties": {
        "orni.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to an installed Orni executable. Leave empty to use the bundled compiler."
        },
        "orni.sourcePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the Orni source repository, used for Ctrl+Click navigation to native Rust implementations."
        }
      }
    },
    "keybindings": [
      {
        "command": "orni.quickFix",
        "key": "ctrl+[Period]",
        "when": "editorTextFocus && editorLangId == orni"
      }
    ],
    "commands": [
      {
        "command": "orni.explainDiagnostic",
        "title": "Orni: Explain Diagnostic"
      },
      {
        "command": "orni.quickFix",
        "title": "Orni: Quick Fix"
      },
      {
        "command": "orni.analyzeWorkspace",
        "title": "Orni: Analyze Workspace"
      },
      {
        "command": "orni.startDevelopmentServer",
        "title": "Orni: Start Development Server",
        "icon": "$(play)"
      },
      {
        "command": "orni.stopDevelopmentServer",
        "title": "Orni: Stop Development Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "orni.restartDevelopmentServer",
        "title": "Orni: Restart Development Server",
        "icon": "$(refresh)"
      },
      {
        "command": "orni.validateApplication",
        "title": "Orni: Validate Application"
      },
      {
        "command": "orni.checkModule",
        "title": "Orni: Check Current File as Module"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "orni.startDevelopmentServer",
          "when": "editorLangId == orni",
          "group": "navigation"
        },
        {
          "command": "orni.stopDevelopmentServer",
          "when": "editorLangId == orni",
          "group": "navigation"
        },
        {
          "command": "orni.restartDevelopmentServer",
          "when": "editorLangId == orni",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "orni",
        "aliases": [
          "Orni",
          "orni"
        ],
        "extensions": [
          ".orni"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/orni-file.png",
          "dark": "./icons/orni-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "orni",
        "scopeName": "source.orni",
        "path": "./syntaxes/orni.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "@iarna/toml": "2.2.5"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
