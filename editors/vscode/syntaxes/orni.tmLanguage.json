{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orni",
  "scopeName": "source.orni",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functionDeclarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functionCalls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.orni",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orni",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.orni",
              "match": "\\\\[nt\"\\\\]"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.orni",
          "match": "'(?:\\\\[nt'\\\\]|[^'\\r\\n])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.orni",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.orni",
          "match": "\\b(?:string|int|double|bool|char|unit)\\b"
        }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.orni" },
            "2": { "name": "entity.name.function.orni" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.orni",
          "match": "\\b(?:if|else|return)\\b"
        },
        {
          "name": "storage.type.orni",
          "match": "\\b(?:let|func)\\b"
        },
        {
          "name": "support.function.orni",
          "match": "\\bprint\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.orni",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.orni",
          "match": "->|==|!=|>=|<=|[=:+\\-*/!<>]"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "meta.function-call.orni",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.orni" }
          }
        }
      ]
    }
  }
}
