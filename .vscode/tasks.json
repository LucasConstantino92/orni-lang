{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Orni: Run current file",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--target",
        "wasm32-wasip1",
        "--",
        "${relativeFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Orni: Run playground",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--target",
        "wasm32-wasip1",
        "--",
        "playground/main.orni"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Orni: Check project",
      "type": "process",
      "command": "cargo",
      "args": ["check", "--all-targets", "--target", "wasm32-wasip1"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Orni: Run tests",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--target", "wasm32-wasip1"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
