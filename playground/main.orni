// Edit this file while learning and developing Orni.

// Hover over `project` to see its inferred `string<4>` type.
let project = "Orni";
let version: int = 1;
let initial: char = 'O';
let progress: double = 0.4;
let worker_count: uint8 = 8;
let server_port: uint16 = 8080;

/// Describes the current development status of a project.
func status(name: string, current_version: int = 1) -> string {
    if current_version >= 1 {
        return name + " is growing!";
    } else {
        return name + " is just getting started.";
    }
}

print status(project, version);
print status("A new project");
print initial;
print progress;
print worker_count;
print server_port;
print 6 * 7 == 42;
